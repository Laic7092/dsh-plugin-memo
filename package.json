{
  "name": "dsh-plugin-memo",
  "version": "0.3.4",
  "description": "Project memory for DeepSeek Harness: a committed .memo/ directory holding STATUS.md, an action journal and a bug log, exposed as model tools, a /memo human command, and a Memo view in the session.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "tokenizer/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1"
  },
  "optionalDependencies": {
    "tree-sitter-wasm": "^2.0.1",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts",
    "prepare": "npm run build"
  }
}
