# Installed dependencies (including the optional tree-sitter packages and the
# @deepseek-ai/dsh-tools link a host provides). Nothing here is committed.
node_modules/

# Compiler output; npm run build (and prepare on install) regenerates it.
lib/


.memo/

# Scratch cache from packing locally (npm pack --cache ./.npm-cache), because the
# user-level npm cache is not writable from every sandbox this repo runs in.
.npm-cache/

# Local pack output (the profile installs from this file): a build artifact,
# and the one file in here that must exist on disk but never in history.
*.tgz
